  "version": 1,
  "name": "io-vm",
  "kind": "appliance",
  "tests": [
    [
      "make",
      "-C",
      "{component}",
      "test"
    ]
  ],
  "build": {
    "makefile": "mk/build.mk",
    "actions": {
      "*": [
        [
          "make",
          "-C",
          "{source}",
          "{action}",
          "OUTPUT={out}"
        ]
      ]
    }
  },
  "test_requires_rust": false
}
